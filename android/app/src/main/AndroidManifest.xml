<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!--
      🔴 审批提醒相关权限。缺任何一条，症状都是**静默的**：

      · POST_NOTIFICATIONS（Android 13+）：没有它，通知不报错、直接不显示 ——
        服务在守护、审批到了手机、用户什么都看不到。
      · FOREGROUND_SERVICE / ..._DATA_SYNC：没有它，前台服务起不来，
        锁屏或切后台后 WebView 的 WebSocket 被挂起，连接断掉。
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!--
      🔴 OTA 自更新必需（用户要求「不要每次插线安装」）。
      缺 REQUEST_INSTALL_PACKAGES 时，startActivity(ACTION_VIEW apk) **不抛异常**，
      而是被系统静默吞掉 —— 用户看到的只是「点了没反应」。
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="DSH Remote"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DshMobile"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          OTA 的 APK 共享通道（Android 7.0+ 必需）。
          直接把 file:// URI 交给安装器会抛 FileUriExposedException，
          异常一旦被 catch 就变成「点了没反应」；必须走 FileProvider 的 content:// URI。
          authority 带包名后缀 `.ota`，与 UpdateManager.install() 里保持一致。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.ota"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          审批中继：持有原生 WebSocket，不受 WebView 生命周期影响。
          exported=false：只有本 App 能启动它。
        -->
        <service
            android:name=".relay.ApprovalRelayService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 通知按钮的落点。exported=false：外部应用无法伪造一个"允许"。 -->
        <receiver
            android:name=".relay.RelayActionReceiver"
            android:exported="false" />
    </application>

</manifest>
