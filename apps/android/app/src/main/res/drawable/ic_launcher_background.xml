<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher background - full-bleed 108x108.

  Layered so it reads as a material surface rather than a flat colour chip:
    1. a diagonal brand ramp  #5b83ff -> #3964fe -> #1a2a80
    2. an off-centre radial lift in #7ba3ff (the "light source")
    3. a faint indigo vignette that seats the mark against the edges

  All three fill the whole viewport so any launcher mask (circle, squircle,
  rounded square, full bleed) stays covered.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0.0" android:color="#FF5B83FF" />
                <item android:offset="0.55" android:color="#FF3964FE" />
                <item android:offset="1.0" android:color="#FF1A2A80" />
            </gradient>
        </aapt:attr>
    </path>

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="32"
                android:centerY="24"
                android:gradientRadius="92">
                <item android:offset="0.0" android:color="#4D7BA3FF" />
                <item android:offset="0.55" android:color="#267BA3FF" />
                <item android:offset="1.0" android:color="#007BA3FF" />
            </gradient>
        </aapt:attr>
    </path>

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="78">
                <item android:offset="0.0" android:color="#002B4EC9" />
                <item android:offset="0.55" android:color="#002B4EC9" />
                <item android:offset="1.0" android:color="#8C2B4EC9" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
