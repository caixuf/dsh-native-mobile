<?xml version="1.0" encoding="utf-8"?>
<!--
  网关可能跑在局域网明文 HTTP 上（DSH 自身的 webserver 就是 HTTP），
  因此这里显式放开明文流量。公网入口请使用 HTTPS 隧道。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>